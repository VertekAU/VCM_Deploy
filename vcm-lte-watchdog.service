[Unit]
Description=VCM LTE watchdog — recover LTE that didn't come back by itself
After=vcm-modem-reconnect.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vcm_lte_watchdog.sh
# A recovery re-runs vcm-modem-reconnect, which can take up to 10 minutes
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
# Runs 720 times a day: keep systemd's start/finish lines out of the journal,
# but record the watchdog's own messages (logged at notice)
SyslogLevel=notice
LogLevelMax=notice
